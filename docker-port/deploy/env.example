# Copy to .env at the repo root of docker-port (next to this deploy\ folder) and
# edit. Do NOT commit the real .env - it holds the database password.
POSTGRES_USER=granado
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ge_data
# Where the client's ge\ folder sits on the host: the mount is REQUIRED, and it
# carries dictionary_local.xml, dictionary_local_serverpack.xml and xml\.
GE_CLIENT_DIR=/srv/ge
